<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all credential/token stores from cloud backup -->
        <exclude domain="sharedpref" path="jellyfin_prefs.xml"/>
        <exclude domain="sharedpref" path="navidrome_prefs.xml"/>
        <exclude domain="sharedpref" path="netease_prefs.xml"/>
        <exclude domain="sharedpref" path="gdrive_prefs.xml"/>
        <exclude domain="sharedpref" path="qqmusic_prefs.xml"/>

        <!-- Also exclude the plaintext fallback files written when
             EncryptedSharedPreferences fails to initialize (e.g. Keystore
             error after a device PIN/biometric change). Without these
             excludes, credentials could be uploaded to cloud backup in
             cleartext on a transient Keystore failure. -->
        <exclude domain="sharedpref" path="jellyfin_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="navidrome_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="netease_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="gdrive_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="qqmusic_prefs_plain.xml"/>

        <!-- Main VYBE preferences are intentionally included so Android's encrypted
             account backup can restore the user's UI/playback choices on a new phone.
             Provider authentication stores remain excluded above. -->
    </cloud-backup>
    <device-transfer>
        <!-- Also exclude from device-to-device transfers — user must re-authenticate -->
        <exclude domain="sharedpref" path="jellyfin_prefs.xml"/>
        <exclude domain="sharedpref" path="navidrome_prefs.xml"/>
        <exclude domain="sharedpref" path="netease_prefs.xml"/>
        <exclude domain="sharedpref" path="gdrive_prefs.xml"/>
        <exclude domain="sharedpref" path="qqmusic_prefs.xml"/>

        <exclude domain="sharedpref" path="jellyfin_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="navidrome_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="netease_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="gdrive_prefs_plain.xml"/>
        <exclude domain="sharedpref" path="qqmusic_prefs_plain.xml"/>

        <!-- Main VYBE preferences are included for device-to-device migration. -->
    </device-transfer>
</data-extraction-rules>
