{
  "rewrites": [
    { "source": "/auth/spotify/callback", "destination": "/auth/spotify/callback.html" },
    { "source": "/play", "destination": "/play.html" },
    { "source": "/watch", "destination": "/play.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
